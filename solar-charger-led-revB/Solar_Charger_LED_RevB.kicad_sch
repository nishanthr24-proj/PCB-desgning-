 65 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "5dcbb9e0-c3d1-4f4d-85c7-256b738505e8")) (text "2. LT3652 CHARGER / POWER STAGE" (at 142.24 22.86 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "d5c79ab0-78a3-4ad4-90fd-d3e6189c8b45")) (text "R6 sets 500 mA maximum charge current.\n1S protected Li-ion cell only; 4.20 V full charge.\nBattery connector pin 1 = BAT+; pin 2 = GND." (at 279.4 109.22 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "7351bedb-d7bb-4a25-b20b-078b6a4d6c70")) (text "3. PANEL VOLTAGE REGULATION" (at 30.48 121.92 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "6bd1415d-243d-4b1a-a3ca-f77f3798d229")) (text "Protected VIN regulation target = 17.874 V.\nPanel target = 17.874 V + D5 drop.\nFixed voltage regulation; not dynamic MPPT." (at 30.48 190.5 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "f0e27af2-60c8-49c0-8f61-58e7e3aad4ca")) (text "4. TIMER" (at 121.92 132.08 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "0bf486db-96e6-4a18-a496-4e7fed262605")) (text "Nominal 3 h; bad-battery\npreconditioning timeout ~22.5 min.\nTimer retries if float not reached." (at 121.92 185.42 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid "c0111199-dc8c-4b53-a848-6a4c22ff685d")) (text "5. PRECISION BATTERY FEEDBACK" (at 198.12 121.92 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "12701d90-e5e3-44e9-994f-32d72fe244fc")) (text "Vfloat = 3.3*(1+60.0k/220k) = 4.200 V\nR3 + (R4 || R5) = 250.14 kohm\nUse specified 0.1% feedback resistors." (at 198.12 193.04 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid "18780797-1487-4a85-8373-60a6a7668588")) (text "6. TEMPERATURE SENSOR" (at 312.42 137.16 0) (effects (font (size 1.6 1.6)) (justify left)) (uuid "fc0a3254-8a40-46e8-9350-9fd8bf101733")) (text "Attach 10k NTC, B=3380 K, to cell.\nNominal charge window ~0 to 40 C.\nOpen sensor DISABLES temperature monitoring." (at 312.42 185.42 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid "5a788ab3-e778-4947-b25f-2e24a2d15f57")) (text "7. ADDED STATUS LEDs" (at 30.48 203.2 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "eb8e9379-007e-4888-9e3d-fd7d1071550f")) (text "Green only: charging >=C/10 (50 mA nominal).\nRed only: bad-battery timeout. Both: NTC fault.\nBoth off: standby, no input, or low charging current.\nLEDs are powered from solar VIN; off does not prove full charge." (at 172.72 226.06 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "e646166e-bd1a-4b02-a8f7-bee6adca7c9e")) (text "VIN-LEVEL STATUS\nNOT MCU SAFE\nVIN_REG: analog sense only" (at 345.44 247.65 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid "01b3c496-6465-4f59-a45e-d0c319e1e477")) (text "ENGINEERING PROTOTYPE - ERC/DRC do not replace bench verification. No lithium cell until dummy-load checks pass." (at 30.48 277 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "39f458c1-05d4-4f66-97d2-d41a159a5a69")) (embedded_fonts no) (wire (pts (xy 41.91 88.9) (xy 36.83 88.9)) (stroke (width 0) (type default)) (uuid "e2f7bffe-188c-46b4-a003-5a262abf5eba")) (label "VIN_RAW" (at 36.83 88.9 180) (effects (font (size 0.9 0.9)) (justify left)) (uuid "f3e76c6f-a403-41ba-9b22-84b99d32aa08")) (wire (pts (xy 49.53 88.9) (xy 54.61 88.9)) (stroke (width 0) (type default)) (uuid "ef247aff-273f-4397-a9bd-68e1e35f57fb")) (label "VIN_FUSED" (at 54.61 88.9 0) (effects (font (size 0.9 0.9)) (justify left)) (uuid "0ed73a04-4a87-49f0-a342-6edd9a02e913")) (symbol (lib_id "SolarCharger:Fuse") (at 45.72 88.9 90) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "358b8025-8996-40f5-83c4-f498e9020fb1") (property "Reference" "F1" (at 44.45 85.09 90) (effects (font (size 0.9 0.9)) (justify left))) (property "Value" "1A / >=32VDC" (at 40.64 93.98 90) (effects (font (size 0.9 0.9)) (justify left))) (property "Footprint" "SolarCharger:Fuse_1206_3216Metric" (at 45.72 88.9 90) (effects (font (size 0.9 0.9)) (justify left) (hide yes))) (property "Design_Note" "Fast acting replaceable DC fuse; >=32